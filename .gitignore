# macOS
.DS_Store

# Xcode user state (per-user, should never be committed)
*.xcuserstate

# Node.js dependencies
functions/node_modules/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml

# IDE / editor
.idea/
.cursor/
# Widget Preview related
.widget_preview/

# Local design-review renders — never committed.
design-review/

# Rules tests pull their own node_modules
test/rules/node_modules/
test/rules/package-lock.json
firestore-debug.log
firebase-debug.log

# Firebase Hosting's deploy cache, written by `firebase deploy`.
.firebase/
