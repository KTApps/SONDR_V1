rules_version = '2';

// Sondr — every user's data lives under users/{uid} and is private to that
// (anonymous or signed-in) user. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Unique handle index. Anyone signed in can read it (to check availability
    // and, later, look up friends by handle). A handle can be created only by
    // its owner and is immutable once claimed — so it can't be stolen or
    // reassigned.
    match /usernames/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Friendships: one doc per pair, id = the two uids sorted and joined. Only
    // the two participants can ever see or touch it (no strangers). Creating is
    // the requester sending a pending request; the recipient (and only they)
    // flips it to accepted; either side may delete (decline / cancel / unfriend).
    match /friendships/{pairId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.users
                    && request.auth.uid != resource.data.requestedBy
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.users == resource.data.users
                    && request.resource.data.requestedBy == resource.data.requestedBy;
    }

    // Feed posts. Friends-only: each post carries an `audience` array (the
    // author's accepted friends at post time + self), so the feed is a single
    // `audience array-contains uid` query and the read rule needs no per-post
    // friendship lookup. Only the author writes their own posts.
    match /posts/{postId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.audience;

      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.auth.uid in request.resource.data.audience;

      allow update, delete: if request.auth != null
                            && resource.data.authorUid == request.auth.uid;
    }
  }
}
