rules_version = '2';

// Sondr — every user's data lives under users/{uid} and is private to that
// (anonymous or signed-in) user. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    // A counter may only stay put or move by one (used to bound like/comment
    // bumps by audience members who aren't the post author).
    function counterStep(a, b) {
      return b == a || b == a + 1 || b == a - 1;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // A like leaves a mirror in the liker's own space, named by the post.
    // When the author deletes that post, the mirror is the one piece of it
    // standing in somebody else's space — so the author may remove THAT
    // document and nothing else: delete only, no read, no write, and only
    // the mirror whose name is a post of theirs. The lookup needs the post
    // to still exist, which is why a deletion removes it last.
    //
    // And only together with the like it mirrors: `existsAfter` reads the
    // state the write leaves behind, so the copy under the post must
    // already be gone or be going in the same batch. An author cannot
    // reach into somebody's space to take the mirror on its own and
    // leave them "liked" with nothing to show for it; the only shape this
    // allows is the one a deletion actually writes.
    match /users/{ownerUid}/likes/{postId} {
      allow delete: if request.auth != null
                    && request.auth.uid ==
                       get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                    && !existsAfter(
                         /databases/$(database)/documents/posts/$(postId)/likes/$(ownerUid));
    }

    // Unique handle index. Anyone signed in can read it (to check availability
    // and, later, look up friends by handle). A handle can be created only by
    // its owner and is immutable once claimed — so it can't be stolen or
    // reassigned.
    match /usernames/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // Still immutable: an update would point an existing handle at
      // another uid in place, which is the theft the create rule exists to
      // stop.
      allow update: if false;

      // Deleting an account has to give its handle back, and the client is
      // the only thing that can do it — there are no Cloud Functions here.
      // Only the holder, so nobody can take a handle off anybody else, and
      // a handle given up is claimable by whoever asks next.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Friendships: one doc per pair, id = the two uids sorted and joined. Only
    // the two participants can ever see or touch it (no strangers). Creating is
    // the requester sending a pending request; the recipient (and only they)
    // flips it to accepted; either side may delete (decline / cancel / unfriend).
    // A block is directional: `a__b` means a blocked b. Readable by the
    // blocker ALONE — telling someone they have been blocked is itself
    // information — but the id is derived so the rules below can exists() it
    // on behalf of a user who cannot read it. The derivation must stay
    // identical to Block.idFor in lib/features/friends/models/block.dart.
    match /blocks/{blockId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.blocker;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.blocker
                    && blockId == request.auth.uid + '__'
                                  + request.resource.data.blocked
                    && request.resource.data.blocked != request.auth.uid;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.blocker;

      allow update: if false;
    }

    function blocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '__' + b));
    }

    // Blocked in EITHER direction stops a friendship forming. Checked in the
    // rules and not only in the client, because sendRequest is a plain write
    // a modified client could make directly.
    function blockedEitherWay(users) {
      return blocked(users[0], users[1]) || blocked(users[1], users[0]);
    }

    // The friendships document id for a pair: the two uids sorted and
    // joined. MUST stay byte-identical to Friendship.pairId in
    // lib/features/friends/models/friendship.dart — if the two drift apart
    // the mirror rules below look up a document that does not exist and
    // every friend list silently stops being readable.
    function pairId(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    // Whether a and b are friends, as things stand. A missing document is
    // null, not an error, so a pair who have never met is simply false.
    function acceptedBetween(a, b) {
      let pair = get(/databases/$(database)/documents/friendships/$(pairId(a, b)));
      return pair != null && pair.data.status == 'accepted';
    }

    // Whether they are friends AFTER this write lands. The accepter writes
    // both halves of the mirror in the same batch as the acceptance itself,
    // so at the moment the rule runs the friendship is still pending —
    // get() would refuse the very write that makes it true.
    function acceptedAfter(a, b) {
      let pair = getAfter(/databases/$(database)/documents/friendships/$(pairId(a, b)));
      return pair != null && pair.data.status == 'accepted';
    }

    // Whether `actor` has a request to `target` standing AFTER this write —
    // the request and its notification land in one batch.
    function pendingRequestAfter(actor, target) {
      let pair = getAfter(/databases/$(database)/documents/friendships/$(pairId(actor, target)));
      return pair != null && pair.data.status == 'pending'
             && pair.data.requestedBy == actor;
    }

    // Whether `actor` has just recorded `inviter` as the one who invited
    // them — the invite and its notification land in one batch.
    function invitedAfter(actor, inviter) {
      let inv = getAfter(/databases/$(database)/documents/invites/$(actor));
      return inv != null && inv.data.invitedBy == inviter;
    }

    // Whether `handle` is claimed by `uid` in the usernames index. A public
    // profile that could name any handle would be an impersonation vector:
    // the handle is the name everything else in the app goes by.
    function handleIsTheirs(handle, uid) {
      let claim = get(/databases/$(database)/documents/usernames/$(handle));
      return claim != null && claim.data.uid == uid;
    }

    match /friendships/{pairId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && !blockedEitherWay(request.resource.data.users);

      // Accepting is also denied across a block, so a request that predates
      // the block cannot be used to re-friend.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.users
                    && request.auth.uid != resource.data.requestedBy
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.users == resource.data.users
                    && request.resource.data.requestedBy == resource.data.requestedBy
                    && !blockedEitherWay(resource.data.users);
    }

    // An author can find their own comments wherever they are, which is what
    // pruning needs: a collection-group query over `comments` filtered by
    // authorUid. Read only, and only your own — the filter is provable from
    // the query, so the query returns your comments rather than failing.
    //
    // This sits alongside the per-post rule below; a match that allows is
    // enough, so it also means you can always see your own comment even
    // after you have pruned yourself out of nothing.
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null
                  && resource.data.authorUid == request.auth.uid;
    }

    // The same shape, for the notices an account caused: a leaving
    // account finds them with a collection-group query over `items`
    // filtered by actorUid, and a group query matches only a rule written
    // with the recursive wildcard — the per-inbox rule below does not
    // answer for one. Read only, and only the ones you caused: the filter
    // is provable from the query, so it returns them rather than failing.
    // Taking them down is the per-inbox rule's business.
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null
                  && resource.data.actorUid == request.auth.uid;
    }

    // Reports.
    //
    // Write-only, from the client's side: a report is a message to us, and
    // nothing in the app ever reads one back. No read, no update, no
    // delete — not even by the person who sent it — so a report cannot be
    // withdrawn, edited, or counted by anyone holding a phone.
    //
    // The id is derived — "<reporter>__<type>__<key>" — which is what
    // makes a second report of the same target by the same person fail on
    // create rather than pile up. The client treats that failure as
    // success, because from the reporter's point of view it is: they have
    // already told us.
    //
    // A comment's key is "<postId>/<commentId>", because that is where a
    // moderator has to look and the slash says so. A slash cannot be in a
    // document id, so the id swaps it for an underscore — the key itself
    // keeps the readable form.
    // Who invited whom. One document per invited account, written once by
    // that account and never again: this is a fact about how they arrived,
    // not a setting.
    //
    // The handle is carried alongside the uid so the pair can be read back
    // without a second lookup, and the rule checks the two against the
    // usernames index — so an invite cannot credit somebody who does not
    // hold that handle. A guest cannot write one: an anonymous session has
    // no account for an invitation to belong to.
    match /invites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.firebase.sign_in_provider
                       != 'anonymous'
                    && request.resource.data.keys().hasOnly(
                         ['invitedBy', 'invitedByHandle', 'at'])
                    && request.resource.data.keys().hasAll(
                         ['invitedBy', 'invitedByHandle', 'at'])
                    && request.resource.data.invitedBy is string
                    && request.resource.data.invitedBy != uid
                    && request.resource.data.invitedByHandle is string
                    && get(/databases/$(database)/documents/usernames/
                           $(request.resource.data.invitedByHandle)).data.uid
                       == request.resource.data.invitedBy
                    && request.resource.data.at == request.time;

      // It happened once. Nothing about it can be revised.
      allow update: if false;

      // Theirs to remove, which is what deleting an account does.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && reportId == request.auth.uid + '__'
                                   + request.resource.data.targetType + '__'
                                   + request.resource.data.targetKey
                                       .split('/').join('_')
                    && request.resource.data.keys().hasOnly([
                         'reporterUid', 'targetType', 'targetKey',
                         'targetOwnerUid', 'reason', 'createdAt',
                       ])
                    && request.resource.data.keys().hasAll([
                         'reporterUid', 'targetType', 'targetKey',
                         'targetOwnerUid', 'reason', 'createdAt',
                       ])
                    && request.resource.data.targetType in
                         ['post', 'comment', 'user']
                    && request.resource.data.reason in
                         ['spam', 'sexual', 'hate', 'violence', 'other']
                    && request.resource.data.targetKey is string
                    && request.resource.data.targetKey.size() > 0
                    && request.resource.data.targetOwnerUid is string
                    && request.resource.data.createdAt == request.time;
    }

    // What a profile for OTHER people can show.
    //
    // `users/{uid}/**` is owner-only, so nothing about another person is
    // readable from it — not their handle, not their hours. A profile needs
    // a published copy of the few facts it shows, and this is it: the
    // handle, the display name, and whole hours. The owner's own client
    // writes it, debounced; the handle is checked against the usernames
    // index so the doc cannot claim someone else's name.
    //
    // Readable by any signed-in user, and deliberately NOT block-aware. A
    // read that failed for one person and succeeded for another would be
    // the tell that they had been blocked, which is the one thing a block
    // must never disclose. Blocks are enforced where they already are: on
    // the writes, whose refusals are worded identically to "no one found".
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && handleIsTheirs(request.resource.data.handle, uid);

      // A delete carries no incoming document, so there is nothing to check
      // but ownership.
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Their friends, mirrored.
      //
      // `friendships` itself cannot answer "who are their friends": a rule
      // asking whether the reader is a friend of one of a document's two
      // participants would have to look up a path built from that
      // document's own data, which a list query cannot prove, so the whole
      // query would fail rather than return the allowed rows. Here the path
      // names the owner, so the lookup is built from the path — the same
      // shape as a comment's rule reaching its parent post.
      //
      // Id-only on purpose: the document id IS the friend's uid, and each
      // row renders from that person's own publicProfiles doc, so a name
      // can neither go stale nor be forged.
      match /friends/{friendUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || acceptedBetween(request.auth.uid, uid));

        // Either party may write either half, so the acceptance and both
        // halves of the mirror are one batch — and a half can only exist
        // where the friendship really does.
        allow create, update: if request.auth != null
                              && (request.auth.uid == uid
                                  || request.auth.uid == friendUid)
                              && request.resource.data.keys().hasOnly(['since'])
                              && acceptedAfter(uid, friendUid);

        // Either party may remove either half, so unfriending and blocking
        // clear the mirror in the same batch that clears the friendship.
        allow delete: if request.auth != null
                      && (request.auth.uid == uid
                          || request.auth.uid == friendUid);
      }
    }

    // Feed posts. Friends-only: each post carries an `audience` array (the
    // author's accepted friends at post time + self), so the feed is a single
    // `audience array-contains uid` query and the read rule needs no per-post
    // friendship lookup. Only the author writes their own posts.
    // In-app notifications: one document per event, under the RECIPIENT,
    // written by the ACTOR. users/{uid}/** is owner-only, so these live at
    // the top level; the recipient alone reads and deletes them (deleting
    // an account deletes them), nobody updates one, and an actor may only
    // write the kind of notice the thing they just did allows — a like to
    // a friend, a request to the person asked, an acceptance to the one
    // who asked, an invite to the one who invited. Never to yourself. The
    // keys are exact per kind, and `at` is the server's clock.
    match /notifications/{recipientUid}/items/{itemId} {
      // The recipient, and the person who caused it. The actor's grant is
      // what lets a leaving account take its name out of everyone else's
      // notices — and it is provable for the collection-group query the
      // cascade runs (`items` where actorUid == me), because the query
      // constrains the very field the rule reads. Nothing else is opened:
      // a notice is still never updated, and still only created by its
      // own actor.
      allow read, delete: if request.auth != null
                          && (request.auth.uid == recipientUid
                              || request.auth.uid == resource.data.actorUid);
      allow update: if false;
      allow create: if request.auth != null
                    && request.resource.data.actorUid == request.auth.uid
                    && request.auth.uid != recipientUid
                    && request.resource.data.actorHandle is string
                    && request.resource.data.at == request.time
                    && (
                      (
                        request.resource.data.type == 'request'
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'at'])
                        && pendingRequestAfter(request.auth.uid, recipientUid)
                      ) || (
                        request.resource.data.type == 'accepted'
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'at'])
                        && acceptedAfter(request.auth.uid, recipientUid)
                      ) || (
                        request.resource.data.type == 'like'
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'postId', 'at'])
                        && request.resource.data.postId is string
                        && acceptedBetween(request.auth.uid, recipientUid)
                      ) || (
                        (request.resource.data.type == 'comment' || request.resource.data.type == 'reply')
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'postId', 'commentId', 'at'])
                        && request.resource.data.postId is string
                        && request.resource.data.commentId is string
                        && acceptedBetween(request.auth.uid, recipientUid)
                      ) || (
                        request.resource.data.type == 'milestone'
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'postId', 'taskName', 'hours', 'at'])
                        && request.resource.data.postId is string
                        && request.resource.data.taskName is string
                        && request.resource.data.hours is int
                        && acceptedBetween(request.auth.uid, recipientUid)
                      ) || (
                        request.resource.data.type == 'invite'
                        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorHandle', 'at'])
                        && invitedAfter(request.auth.uid, recipientUid)
                      )
                    );
    }

    match /posts/{postId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.audience;

      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.auth.uid in request.resource.data.audience;

      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      // Author has full edit rights. An audience member may only nudge the
      // like/comment counters by ±1 — the bump batched alongside their own like
      // mirror (users/{uid}/likes) or comment doc.
      allow update: if request.auth != null && (
        resource.data.authorUid == request.auth.uid
        || (
          request.auth.uid in resource.data.audience
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount', 'commentCount'])
          // Treat a missing counter as 0 — posts created before counters
          // existed have no field, and null arithmetic would deny the rule.
          && counterStep(resource.data.get('likeCount', 0),
                         request.resource.data.get('likeCount', 0))
          && counterStep(resource.data.get('commentCount', 0),
                         request.resource.data.get('commentCount', 0))
        )
      );

      // Comments carry their OWN audience, copied from the post at creation.
      //
      // The post's audience is frozen at post time and the author can prune
      // it (blocking, unfriending); a comment needs the same, and it cannot
      // borrow the post's, because the commenter does not own the post and
      // could not prune it. So the comment has a copy, and the reader must
      // be in BOTH: the comment's, which the query proves, and the post's,
      // which is one lookup shared by every row.
      //
      // The audience clause has to be provable from the query, or the whole
      // comments query fails rather than omitting rows — rules are not
      // filters. watchComments carries the matching array-contains.
      match /comments/{commentId} {
        allow read: if request.auth != null
                    && request.auth.uid in resource.data.audience
                    && request.auth.uid in
                       get(/databases/$(database)/documents/posts/$(postId)).data.audience;

        // The audience must be the post's, exactly. A commenter cannot
        // invent an audience to reach people the post never reached.
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/posts/$(postId)).data.audience
                      && request.resource.data.audience ==
                         get(/databases/$(database)/documents/posts/$(postId)).data.audience
                      // A reply names its parent: an existing TOP-LEVEL
                      // comment on this same post. One level, never deeper.
                      && (
                        !('parentId' in request.resource.data)
                        || (
                          request.resource.data.parentId is string
                          && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))
                          && !('parentId' in get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId)).data)
                        )
                      );

        // The audience only, and never the text after people have read
        // it. The author may NARROW it (a block, an unfriend), or set it to
        // the post's audience EXACTLY — which is how a comment follows its
        // post when a new friend is let in. Any other widening is a forged
        // reach and is refused.
        allow update: if request.auth != null
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['audience'])
                      && (
                        resource.data.audience
                           .hasAll(request.resource.data.audience)
                        || request.resource.data.audience ==
                           get(/databases/$(database)/documents/posts/$(postId)).data.audience
                      );

        // Yours to delete — and a reply under YOUR comment is yours to
        // take down with it, which is what lets deleting a comment delete
        // its replies in one batch.
        allow delete: if request.auth != null
                      && (
                        resource.data.authorUid == request.auth.uid
                        || (
                          'parentId' in resource.data
                          && get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.authorUid
                             == request.auth.uid
                        )
                        // The post's author, clearing what is under their
                        // own post as they delete it. Delete only, and only
                        // while the post still stands.
                        || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                           == request.auth.uid
                      );
      }

      // Who liked a post: one document per liker, named by them. Written
      // only by that person, and only while the post reaches them; read by
      // anyone the post reaches — the author included, which is what lets
      // them see who liked their own post. The counter on the post still
      // moves in the same batch (see the update rule above).
      match /likes/{likerUid} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/posts/$(postId)).data.audience;
        allow create, delete: if request.auth != null
                              && likerUid == request.auth.uid
                              && request.auth.uid in
                                 get(/databases/$(database)/documents/posts/$(postId)).data.audience;
        // Deleting a post takes what is under it, and a like under it is
        // the author's to clear. Delete only, and only while the post is
        // still there to prove it — which is why the post document is the
        // last thing a deletion removes.
        allow delete: if request.auth != null
                      && request.auth.uid ==
                         get(/databases/$(database)/documents/posts/$(postId)).data.authorUid;
      }
    }
  }
}
