rules_version = '2';

// Sondr photos. Milestone-post images live under the uploader's own space.
// Note: Firebase download URLs carry an access token that bypasses these read
// rules, so friends-only-ness for photos rests on the post's `audience` gating
// (only friends ever receive the URL) rather than on `allow read` here.
service firebase.storage {
  match /b/{bucket}/o {
    // A post's files live under the post's id: `{postId}/0.jpg`, `1.jpg`,
    // … `cover.jpg`, `thumb.jpg` — so a share can be retried by writing the
    // same names again, and a post's folder can be taken down as one. A
    // wildcard is ONE segment, so this match is its own: the flat match
    // below it, kept for the posts of old, never saw these paths, and every
    // upload of a new post was refused as unauthorized.
    match /users/{uid}/posts/{postId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // Posts from before the folders: one file at the flat path.
    match /users/{uid}/posts/{file} {
      allow read: if request.auth != null;
      // create/update carry an incoming file, so they're size/type-checked;
      // delete has no `request.resource`, so it's gated on ownership alone
      // (a blanket `write` with the size/type checks would deny every delete —
      // which is why deletePost's binary cleanup needs this split).
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // Private session photos. Unlike posts these are owner-only on read too —
    // the download URL lives only in the owner's private Firestore doc, so it is
    // never handed to anyone else. (If a photo is later surfaced in the feed,
    // that path reuses the posts space / audience gating above.)
    //
    // create/update carry an incoming file, so they're size/type-checked; delete
    // has no `request.resource`, so it's gated on ownership alone (folding the
    // size/type checks into a blanket `write` would deny every delete).
    // LISTING is checked against the prefix being listed, which no
    // per-file match covers — `users/{uid}/posts` is one segment short of
    // `users/{uid}/posts/{file}`, and a post's own folder,
    // `users/{uid}/posts/{postId}`, is a prefix too. Deleting an account
    // has to find every object it owns, including one whose Firestore
    // document never landed, so the owner may list any prefix of their own
    // at any depth. Names only: reading the bytes is still governed by the
    // matches above.
    match /users/{uid}/{prefix=**} {
      allow list: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/photos/{file} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }
  }
}
