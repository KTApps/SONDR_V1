rules_version = '2';

// Sondr photos. Milestone-post images live under the uploader's own space.
// Note: Firebase download URLs carry an access token that bypasses these read
// rules, so friends-only-ness for photos rests on the post's `audience` gating
// (only friends ever receive the URL) rather than on `allow read` here.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/posts/{file} {
      allow read: if request.auth != null;
      // create/update carry an incoming file, so they're size/type-checked;
      // delete has no `request.resource`, so it's gated on ownership alone
      // (a blanket `write` with the size/type checks would deny every delete —
      // which is why deletePost's binary cleanup needs this split).
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // Private session photos. Unlike posts these are owner-only on read too —
    // the download URL lives only in the owner's private Firestore doc, so it is
    // never handed to anyone else. (If a photo is later surfaced in the feed,
    // that path reuses the posts space / audience gating above.)
    //
    // create/update carry an incoming file, so they're size/type-checked; delete
    // has no `request.resource`, so it's gated on ownership alone (folding the
    // size/type checks into a blanket `write` would deny every delete).
    match /users/{uid}/photos/{file} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }
  }
}
